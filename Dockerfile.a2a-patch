FROM ghcr.io/ibm/mcp-context-forge@sha256:e9639c030162d6cb2f9f188600dd69af8091ec62a7ce307d4a74f4d4f86873df AS runtime
ARG PATCH_REVISION=local
LABEL org.opencontainers.image.revision=$PATCH_REVISION
LABEL org.opencontainers.image.source=https://github.com/DavinciDreams/mcp-context-forge
COPY --chown=10001:10001 mcpgateway/admin.py /app/mcpgateway/admin.py
COPY --chown=10001:10001 mcpgateway/main.py /app/mcpgateway/main.py
COPY --chown=10001:10001 mcpgateway/services/a2a_service.py /app/mcpgateway/services/a2a_service.py

FROM runtime AS validation
USER 0
COPY --from=ghcr.io/astral-sh/uv:0.11.6@sha256:b1e699368d24c57cda93c338a57a8c5a119009ba809305cc8e86986d4a006754 /uv /usr/local/bin/uv
RUN uv pip install --python /app/.venv/bin/python pytest pytest-asyncio pytest-cov pytest-env pytest-timeout pytest-httpx pytest-xdist hypothesis fakeredis
COPY tests /app/tests
COPY pyproject.toml /app/pyproject.toml
WORKDIR /app
ENTRYPOINT ["/app/.venv/bin/python", "-m", "pytest"]
CMD ["tests/unit/mcpgateway/services/test_a2a_streaming.py", "tests/unit/mcpgateway/services/test_a2a_service.py", "tests/unit/mcpgateway/services/test_a2a_protocol.py", "tests/unit/mcpgateway/services/test_a2a_authorization_access.py", "tests/unit/mcpgateway/test_a2a_jsonrpc_passthrough.py", "tests/unit/mcpgateway/test_rpc_tool_invocation.py", "tests/unit/mcpgateway/test_private_agent_test_identity.py", "tests/unit/mcpgateway/test_admin.py", "--no-cov", "--timeout=45", "-o", "addopts=-ra -p no:playwright -p no:benchmark"]
